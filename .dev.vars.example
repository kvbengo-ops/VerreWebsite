# Copy to .dev.vars (gitignored) and fill in for `wrangler dev`.
RESEND_API_KEY=
OWNER_EMAIL=
FROM_EMAIL=Verre <hello@your-verified-domain.example>

# Supabase — used from task-admin.md Phase 1 onward.
# `npx supabase start` prints local values for these.
# The service role key bypasses RLS: Worker only, never browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Access. The team domain includes https://, for example
# https://verre.cloudflareaccess.com. Access authenticates every staff email;
# Verre's Accounts page assigns permissions.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Emergency/bootstrap Super Admin email(s), comma-separated. Keep at least one
# configured until a database-managed Super Admin has been tested.
SUPER_ADMIN_EMAILS=

# Localhost only. authenticate() also checks the request hostname, so this flag
# cannot bypass Access on a deployed host.
LOCAL_AUTH_BYPASS=true
LOCAL_AUTH_EMAIL=local@verre.test

# Optional once the custom domain is connected. It pins canonical URLs and the
# sitemap to one public origin even if the Worker also has another hostname.
PUBLIC_SITE_URL=https://your-exact-domain.example

# Optional URL-prefix Search Console verification. Domain-property verification
# normally uses the Google TXT record in Spaceship DNS instead.
GOOGLE_SITE_VERIFICATION=

# Optional KV namespace for login rate limiting. The in-memory fallback resets
# whenever Cloudflare recycles the isolate, which is fine for the contact form
# and NOT fine for a password gate. Bind this in production.
#   [[kv_namespaces]] binding = "AUTH_LIMITS"
